# ============================================================
# deepseek-vision-mcp 环境变量示例
# 复制为 .env 并填入你自己的 Key（切勿提交到仓库）
# ============================================================

# 视觉模型 API Key（必填，无默认值）
# 智谱 AI:   在 https://open.bigmodel.cn 控制台申请
# 硅基流动:  在 https://cloud.siliconflow.cn 控制台申请
# 通义千问:  在 https://dashscope.console.aliyun.com 申请
VISION_API_KEY=

# 模型名称
# 智谱 AI:    glm-4.6v-flash（免费，推荐，当前免费视觉模型里效果最好）
# 硅基流动:   Qwen/Qwen2.5-VL-7B-Instruct
# 通义千问:   qwen-vl-plus
VISION_MODEL=glm-4.6v-flash

# OpenAI 兼容 API 基础 URL
# 智谱 AI:    https://open.bigmodel.cn/api/paas/v4
# 硅基流动:   https://api.siliconflow.cn/v1
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 图片大小限制（KB），超过会尝试压缩，压缩后仍超限则报错
VISION_MAX_IMAGE_SIZE_KB=2048

# 调用视觉模型 API 的超时时间（秒）
VISION_TIMEOUT_SECONDS=60

# 从 URL 下载图片的超时时间（秒）
VISION_DOWNLOAD_TIMEOUT_SECONDS=30

# 允许的图片格式（逗号分隔）
VISION_ALLOWED_FORMATS=jpg,jpeg,png,webp

# 是否读取 config.json（true/false）
VISION_USE_CONFIG_FILE=true

# 提供商类型（当前仅 openai_compatible）
VISION_PROVIDER=openai_compatible
