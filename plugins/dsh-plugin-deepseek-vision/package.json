{
  "name": "dsh-plugin-deepseek-vision",
  "version": "0.3.1",
  "description": "DeepSeek Harness 原生视觉 Bundle：粘贴或拖入图片，通过托管的 deepseek-vision-mcp 调用 OpenAI 兼容视觉模型。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./launcher": "./launcher.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "deepseek-vision-dsh-runtime": "launcher.js"
  },
  "files": [
    "index.js",
    "client.js",
    "launcher.js",
    "cordis.patch.yml",
    "runtime/*.whl",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "prepare:runtime": "node ./scripts/prepare-runtime.mjs",
    "prepack": "npm run prepare:runtime",
    "test": "node --test ./tests/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "vision",
    "image-analysis",
    "ocr",
    "glm-4.6v-flash"
  ],
  "license": "MIT",
  "author": "deepseek-vision-mcp contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GOU-GEE/deepseek-vision.git",
    "directory": "plugins/dsh-plugin-deepseek-vision"
  },
  "homepage": "https://github.com/GOU-GEE/deepseek-vision#readme",
  "bugs": {
    "url": "https://github.com/GOU-GEE/deepseek-vision/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.5 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
